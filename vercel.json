{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "design/r5-a-preview": false,
      "feat/round7-multipage": false
    }
  },
  "redirects": [
    {
      "source": "/th/for-you/",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/th/for-you",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/th/for-you/index.html",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/th/products/",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/th/products",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/th/products/index.html",
      "destination": "/th/clinic/",
      "permanent": false
    },
    {
      "source": "/en/for-you/",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/en/for-you",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/en/for-you/index.html",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/en/products/",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/en/products",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/en/products/index.html",
      "destination": "/en/clinic/",
      "permanent": false
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.facebook.com https://*.google-analytics.com https://www.googletagmanager.com; media-src 'self'; font-src 'self'; connect-src 'self' blob: https://script.google.com https://script.googleusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://www.googletagmanager.com https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:lang(th|en)/lp/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/:file(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
